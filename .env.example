HOST=0.0.0.0
PORT=3000
DATA_DIR=/data
# Set to your actual public URL when behind a proxy.
# PUBLIC_ORIGIN=https://your-site.example

# Optional: fine-grained token with read-only Issues access to the public repo.
# GITHUB_READ_TOKEN=

# GitHub App login (Issues: read and write; Metadata: read-only).
# Register exactly https://usyd.life/auth/github/callback as the callback.
# PUBLIC_ORIGIN=https://usyd.life
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REPOSITORY_ID=1402408149
